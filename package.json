{
  "name": "kamod-state",
  "version": "0.1.0",
  "private": true,
  "description": "Tiny, typed reducer state management built for Preact.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "prepublishOnly": "node -e \"console.error('Do not publish the workspace root. Use: pnpm publish:core'); process.exit(1)\"",
    "build:core": "pnpm --filter @kamod-ch/state build",
    "test:core": "pnpm --filter @kamod-ch/state test",
    "typecheck:core": "pnpm --filter @kamod-ch/state typecheck",
    "build:docs": "pnpm --filter @kamod-ch/state-docs build",
    "check:docs": "pnpm --filter @kamod-ch/state-docs check",
    "build": "pnpm run build:core && pnpm run build:docs",
    "test": "pnpm run test:core",
    "typecheck": "pnpm run typecheck:core",
    "docs:dev": "pnpm --filter @kamod-ch/state-docs dev",
    "docs:check": "pnpm run check:docs",
    "docs:build": "pnpm run build:docs",
    "brand:readme": "kamod-brand-readme --product State --output .github/assets",
    "pack:core": "pnpm --filter @kamod-ch/state exec npm pack --dry-run",
    "publish:core": "pnpm --filter @kamod-ch/state publish --access public",
    "release:check": "pnpm typecheck && pnpm test && pnpm build && pnpm docs:check",
    "release:publish": "pnpm --filter @kamod-ch/state publish --access public --provenance --no-git-checks",
    "release": "node ./scripts/release.mjs patch",
    "release:minor": "node ./scripts/release.mjs minor",
    "release:major": "node ./scripts/release.mjs major",
    "release:dry": "node ./scripts/release.mjs patch --dry"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@kamod-ch/brand": "^0.4.0"
  }
}
